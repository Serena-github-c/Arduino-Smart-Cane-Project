#include <DFRobotDFPlayerMini.h>
#include <TinyGPS++.h>

// ==== GPS Setup ====
TinyGPSPlus gps;

// ==== Ultrasonic Pins ====
const int trigFront = 28, echoFront = 29;
const int trigLeft  = 30, echoLeft  = 31;
const int trigRight = 32, echoRight = 33;

// ==== LDR and LED ====
const int ldrPin = A0;
const int ledPin = 22;

// ==== Water Sensor ====
const int waterSensorPin = 36;  // OUT from HW-038 → digital pin 36
int lastWaterState = LOW;
unsigned long lastWaterAlertTime = 0;
const unsigned long WATER_ALERT_DELAY = 5000;  // 5s between alerts

// ==== Detection Thresholds ====
const int FRONT_THRESHOLD = 40;
const int SIDE_THRESHOLD = 30;
const int MIN_DISTANCE = 2;
const int MAX_DISTANCE = 400;
const int LIGHT_THRESHOLD = 300;
const unsigned long LIGHT_CHECK_INTERVAL = 500;

// ==== Timing Parameters ====
const unsigned long MESSAGE_DELAY = 3000;
const unsigned long SENSOR_DELAY = 50;
const unsigned long DEBOUNCE_TIME = 200;
DFRobotDFPlayerMini mp3;

// ==== State ====
int lastState = 0;
unsigned long lastPlayTime = 0;
unsigned long lastSensorTime = 0;
unsigned long stateChangeTime = 0;
unsigned long lastLightCheck = 0;

// ==== Filter ====
const int FILTER_SIZE = 3;
float frontReadings[FILTER_SIZE] = {0};
float leftReadings[FILTER_SIZE] = {0};
float rightReadings[FILTER_SIZE] = {0};
int filterIndex = 0;

void setup() {
  Serial.begin(115200);     // For debugging and GPS output
  Serial1.begin(9600);      // For MP3 module
  Serial2.begin(9600);      // For GPS module (TX → RX2 = Pin 17)

  // Init MP3
  if (!mp3.begin(Serial1)) {
    Serial.println("MP3 init failed!");
  }
  delay(500);
  mp3.volume(30);

  // Pin setup
  pinMode(trigFront, OUTPUT); pinMode(echoFront, INPUT);
  pinMode(trigLeft, OUTPUT);  pinMode(echoLeft, INPUT);
  pinMode(trigRight, OUTPUT); pinMode(echoRight, INPUT);
  pinMode(ledPin, OUTPUT);
  pinMode(ldrPin, INPUT);
  pinMode(waterSensorPin, INPUT);  // <-- Water sensor pin

  // Fill filters
  for (int i = 0; i < FILTER_SIZE; i++) {
    frontReadings[i] = MAX_DISTANCE;
    leftReadings[i] = MAX_DISTANCE;
    rightReadings[i] = MAX_DISTANCE;
  }

  Serial.println("System Initialized: Navigation + GPS + Water Sensor");
}

float measureDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW); delayMicroseconds(2);
  digitalWrite(trigPin, HIGH); delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 35000);
  if (duration == 0) return MAX_DISTANCE;

  float distance = (duration * 0.034) / 2.0;
  if (distance < MIN_DISTANCE || distance > MAX_DISTANCE) return MAX_DISTANCE;
  return distance;
}

float filterDistance(float newReading, float* readings) {
  readings[filterIndex] = newReading;
  float sum = 0;
  for (int i = 0; i < FILTER_SIZE; i++) sum += readings[i];
  return sum / FILTER_SIZE;
}

int determineNavigationState(float frontDist, float leftDist, float rightDist) {
  if (frontDist >= FRONT_THRESHOLD) return 0;

  bool leftBlocked = (leftDist < SIDE_THRESHOLD);
  bool rightBlocked = (rightDist < SIDE_THRESHOLD);

  Serial.print("Front: "); Serial.print(frontDist);
  Serial.print(" Left: "); Serial.print(leftDist);
  Serial.print(" Right: "); Serial.println(rightDist);

  if (leftBlocked && rightBlocked) return 3;
  else if (leftBlocked) return 1;
  else if (rightBlocked) return 2;
  else return (leftDist > rightDist) ? 2 : 1;
}

void checkLightLevel() {
  int lightLevel = analogRead(ldrPin);
  Serial.print("Light Level: "); Serial.println(lightLevel);
  digitalWrite(ledPin, (lightLevel < LIGHT_THRESHOLD) ? HIGH : LOW);
}

void printGPS() {
  while (Serial2.available() > 0) {
    if (gps.encode(Serial2.read()) || gps.location.isUpdated()) {
      Serial.print("Latitude = ");
      Serial.print(gps.location.lat(), 6);
      Serial.print("\tLongitude = ");
      Serial.println(gps.location.lng(), 6);
    }
  }
}

void loop() {
  unsigned long currentTime = millis();

  // Rate-limit sensor reading
  if (currentTime - lastSensorTime < SENSOR_DELAY) return;
  lastSensorTime = currentTime;

  // Read ultrasonic sensors
  float frontRaw = measureDistance(trigFront, echoFront);
  float leftRaw = measureDistance(trigLeft, echoLeft);
  float rightRaw = measureDistance(trigRight, echoRight);

  float frontFiltered = filterDistance(frontRaw, frontReadings);
  float leftFiltered = filterDistance(leftRaw, leftReadings);
  float rightFiltered = filterDistance(rightRaw, rightReadings);
  filterIndex = (filterIndex + 1) % FILTER_SIZE;

  int currentState = determineNavigationState(frontFiltered, leftFiltered, rightFiltered);

  // Voice guidance
  if (currentState != lastState) {
    if (currentTime - stateChangeTime > DEBOUNCE_TIME) {
      stateChangeTime = currentTime;

      if (currentTime - lastPlayTime > MESSAGE_DELAY) {
        if (currentState == 1) {
          mp3.play(2); Serial.println("Go Right");
        } else if (currentState == 2) {
          mp3.play(1); Serial.println("Go Left");
        } else if (currentState == 3) {
          mp3.play(3); Serial.println("All Blocked!");
        }
        lastPlayTime = currentTime;
      }

      lastState = currentState;
    }
  } else if (currentState != 0 && currentTime - lastPlayTime > MESSAGE_DELAY) {
    if (currentState == 1) {
      mp3.play(2); Serial.println("Repeat: Go Right");
    } else if (currentState == 2) {
      mp3.play(1); Serial.println("Repeat: Go Left");
    } else if (currentState == 3) {
      mp3.play(3); Serial.println("Repeat: All Blocked!");
    }
    lastPlayTime = currentTime;
  }

  if (currentState == 0) lastState = 0;

  if (currentTime - lastLightCheck >= LIGHT_CHECK_INTERVAL) {
    checkLightLevel();
    lastLightCheck = currentTime;
  }

  // Always check GPS
  printGPS();

  // === Water Sensor Check ===
  int currentWaterState = digitalRead(waterSensorPin);
  if (currentWaterState == HIGH && lastWaterState == LOW) {
    if (currentTime - lastWaterAlertTime > WATER_ALERT_DELAY) {
      mp3.play(4);  // Play 0004.mp3 → "Water Detected"
      Serial.println("🚨 Water Detected!");
      lastWaterAlertTime = currentTime;
    }
  }
  lastWaterState = currentWaterState;
}
